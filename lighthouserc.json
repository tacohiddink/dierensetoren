{
  "ci": {
    "collect": {
      "staticDistDir": "./_site",
      "url": [
        "http://localhost/index.html",
        "http://localhost/geschiedenis.html",
        "http://localhost/activiteiten.html",
        "http://localhost/bereikbaarheid.html",
        "http://localhost/donateur.html",
        "http://localhost/nalaten.html",
        "http://localhost/anbistatus.html",
        "http://localhost/inmemoriam.html",
        "http://localhost/privacy.html",
        "http://localhost/en.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse-rapporten"
    }
  }
}
